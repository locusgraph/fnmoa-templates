          "optional": true
        }
      ],
      "fill": [
        "wrangler.jsonc",
        "package.json",
        "src/pages/index.astro",
        "README.md"
      ]
    },
    {
      "folder": "frontend",
      "name": "Web app",
      "description": "A web app with pages and sign-in screens",
      "picture": "frontend/preview.svg",
      "asks": [
        {
          "id": "title",
          "say": "What is your app called?"
        }
      ],
      "fill": [
        "wrangler.jsonc",
        "package.json",
        "index.html",
        "src/App.tsx",
        "README.md"
      ]
    }
  ]
}
